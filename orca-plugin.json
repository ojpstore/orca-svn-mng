{
  "manifestVersion": 2,
  "id": "svn-mng",
  "name": "SVN",
  "version": "0.1.0",
  "description": "SVN status, update and commit for the focused workspace.",
  "engines": {
    "orca": ">=1.4.247"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "svn-mng",
        "title": "SVN",
        "icon": "upload",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "events": [
      {
        "on": "workspace.changed"
      },
      {
        "on": "workspace.created"
      },
      {
        "on": "workspace.removed"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    }
  ]
}